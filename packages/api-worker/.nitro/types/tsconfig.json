{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "#imports": [
        "./nitro-imports"
      ],
      "~/*": [
        "../../src/*"
      ],
      "@/*": [
        "../../src/*"
      ],
      "~~/*": [
        "../../*"
      ],
      "@@/*": [
        "../../*"
      ]
    },
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "./nitro.d.ts",
    "../../**/*",
    "../../src/**/*"
  ]
}