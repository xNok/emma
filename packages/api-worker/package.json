{
  "name": "@xnok/emma-api-worker",
  "version": "0.4.0",
  "description": "Cloudflare Worker for handling form submissions",
  "type": "module",
  "main": "./src/cloudflare-index.ts",
  "scripts": {
    "build": "nitro build",
    "build:cloudflare": "nitro build --preset cloudflare",
    "build:node": "nitro build --preset node-server",
    "start": "tsx src/node-index.ts",
    "start:dev": "tsx --watch src/node-index.ts",
    "dev": "nitro dev",
    "dev:cloudflare": "wrangler dev .output/server/index.mjs --site .output/public --remote",
    "preview": "node .output/server/index.mjs",
    "deploy": "wrangler deploy .output/server/index.mjs",
    "deploy:staging": "wrangler deploy .output/server/index.mjs --env staging",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "generate:types": "openapi-typescript openapi.yaml --output src/types.ts"
  },
  "dependencies": {
    "@xnok/emma-shared": "workspace:*",
    "h3": "^2.0.1-rc.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231016.0",
    "@types/node": "^20.10.0",
    "nitropack": "^2.12.9",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "wrangler": "4"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "api",
    "forms"
  ]
}
