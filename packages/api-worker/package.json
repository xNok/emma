{
  "name": "@xnok/emma-api-worker",
  "version": "0.3.1",
  "description": "Cloudflare Worker for handling form submissions",
  "type": "module",
  "main": "./src/cloudflare-index.ts",
  "scripts": {
    "build": "esbuild src/cloudflare-index.ts --bundle --format=iife --global-name=worker --outfile=dist/index.js --platform=browser",
    "build:cloudflare": "esbuild src/cloudflare-index.ts --bundle --format=iife --global-name=worker --outfile=dist/index.js --platform=browser",
    "build:node": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.js --platform=node",
    "start": "tsx --watch src/index.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "openapi-typescript openapi.yaml --output src/types.ts"
  },
  "dependencies": {
    "@xnok/emma-shared": "workspace:*",
    "h3": "^2.0.1-rc.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231016.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.5",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "wrangler": "^3.22.1"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "api",
    "forms"
  ]
}
