{
  "name": "@xnok/emma-provider-cloudflare",
  "version": "0.2.0",
  "description": "Cloudflare deployment and submission provider for Emma Forms",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "emma",
    "forms",
    "cloudflare",
    "r2",
    "d1",
    "provider"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.666.0",
    "@xnok/emma-shared": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6",
    "wrangler": "^4.43.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
