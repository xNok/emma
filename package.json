{
  "name": "emma",
  "version": "0.1.0",
  "description": "Embeddable forms system for Hugo websites",
  "private": true,
  "workspaces": [
    "packages/*",
    "shared",
    "website"
  ],
  "scripts": {
    "emma": "node packages/form-builder/dist/cli.js",
    "dev:core": "yarn workspaces foreach -A -p --exclude @xnok/emma-api-worker --exclude emma-website run dev",
    "dev:api": "yarn workspace @xnok/emma-api-worker run dev",
    "dev:website": "yarn workspace emma-website run dev",
    "build": "yarn workspaces foreach -Apt run build",
    "test": "yarn workspaces foreach -Aipt --exclude emma-website run test",
    "test:ci": "yarn workspace @xnok/emma-form-renderer test -- --reporter=junit --coverage",
    "test:website": "yarn workspace emma-website run test",
    "test:all": "yarn test && yarn test:website",
    "test:manual": "yarn workspace @emma/form-renderer exec yarn --cwd test-server dev",
    "test:e2e": "yarn workspace @xnok/emma-form-builder run test:e2e",
    "test:e2e:ci": "yarn workspace @xnok/emma-form-builder run test:e2e:ci",
    "test:e2e:report": "yarn workspace @xnok/emma-form-builder run test:e2e:report",
    "test:e2e:ui": "yarn workspace @xnok/emma-form-builder run test:e2e:ui",
    "test:e2e:headed": "yarn workspace @xnok/emma-form-builder run test:e2e:headed",
    "test:e2e:debug": "yarn workspace @xnok/emma-form-builder run test:e2e:debug",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "yarn workspaces foreach -Apt run clean && rm -rf node_modules",
    "version": "changeset version",
    "release": "yarn build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "husky": "^9.0.11",
    "prettier": "^3.1.1",
    "typescript": "^5.9.3",
    "vitest": "^1.1.0"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/emma.git"
  },
  "keywords": [
    "forms",
    "hugo",
    "cloudflare",
    "embeddable",
    "static-site"
  ],
  "author": "Your Name",
  "license": "MIT"
}
